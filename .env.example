# Contoh konfigurasi. Salin menjadi .env bila perlu; jangan commit kredensial asli.
DATABASE_URL=postgresql://postgres:postgres_password@db:5432/slip_gaji_db
SUPER_ADMIN_EMAIL=teguhe@gmail.com
# Wajib diganti dengan nilai acak yang kuat di production.
INTERNAL_API_KEY=
# Letakkan service account Firebase di path ini (jangan commit file-nya).
FIREBASE_ADMIN_CREDENTIALS=/app/firebase_creds.json
MAX_UPLOAD_MB=20
MAX_IMPORT_ROWS=50000
